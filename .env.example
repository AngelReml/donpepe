# ─── Public site ────────────────────────────────────────────
NEXT_PUBLIC_RESTAURANT_NAME="Don Pepe Original"
# Los dos teléfonos son públicos: el fijo del local y el móvil de reservas.
# El móvil es además el destino del enlace de WhatsApp.
NEXT_PUBLIC_PHONE="34881829728"
NEXT_PUBLIC_PHONE_DISPLAY="881 82 97 28"
NEXT_PUBLIC_PHONE_MOBILE="34696434042"
NEXT_PUBLIC_PHONE_MOBILE_DISPLAY="696 43 40 42"
NEXT_PUBLIC_WHATSAPP="34696434042"
NEXT_PUBLIC_ADDRESS="Rúa Longa, 21, 15900 Padrón, A Coruña"
NEXT_PUBLIC_LAT="42.7386883"
NEXT_PUBLIC_LNG="-8.6604218"
# Opcional: el código ya trae el dominio real por defecto. Defínela solo si
# quieres que una vista previa se anuncie con su propia URL.
NEXT_PUBLIC_SITE_URL="https://donpepeoriginal.es"

# ─── QR admin ───────────────────────────────────────────────
QR_ADMIN_PASS="cambia-esto-por-uno-largo"

# ─── WhatsApp (Meta Cloud) ──────────────────────────────────
# https://developers.facebook.com/apps/ -> WhatsApp -> API Setup
WHATSAPP_PROVIDER="meta"
WHATSAPP_TOKEN="EAAxxxxxxx"        # Permanent system user token
WHATSAPP_PHONE_ID="1234567890"     # Phone number ID
WHATSAPP_VERIFY_TOKEN="el-que-tu-quieras"  # Webhook verify token
WHATSAPP_ALLOWED_NUMBERS="34696434042"     # comma-separated, no spaces
# OBLIGATORIO. App secret de Meta (Configuración > Básica > Clave secreta).
# Con él se comprueba la cabecera X-Hub-Signature-256 de cada mensaje. Si falta,
# el webhook rechaza TODO con 401: el número del remitente viaja en el cuerpo y
# por sí solo no demuestra nada, así que sin firma cualquiera podría hacerse
# pasar por el dueño y cambiar la carta.
WHATSAPP_APP_SECRET=""
# Optional, only if you choose Twilio instead of Meta
# WHATSAPP_PROVIDER="twilio"
# TWILIO_ACCOUNT_SID="ACxxxx"
# TWILIO_AUTH_TOKEN="xxxxx"          # también valida la firma X-Twilio-Signature
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# TWILIO_WEBHOOK_URL=""              # URL pública exacta, si el proxy altera req.url

# ─── LLM (OpenRouter) ───────────────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-xxxx"
# Modelo del agente de WhatsApp (extracción de acciones). Cambiarlo es solo
# esta variable, no hace falta tocar código.
OPENROUTER_MODEL="qwen/qwen3-30b-a3b-instruct-2507"
# Modelo de las traducciones de la carta. Separado a propósito: si uno da
# problemas se cambia sin tocar el otro. Si se deja vacío, usa el de arriba.
OPENROUTER_MODEL_TRADUCCION="qwen/qwen3-30b-a3b-instruct-2507"

# ─── Google Business Profile ────────────────────────────────
# Until Google approves the API request, the system runs in
# simulation mode using the sample reviews in /data/sample-reviews.json
GOOGLE_REVIEWS_ENABLED="false"
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_LOCATION_ID="accounts/123/locations/456"

# ─── Vercel KV (recommended) ────────────────────────────────
# Pulled from Vercel integrations automatically. For local dev,
# either set them manually or run the project on Vercel.
KV_URL=""
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
KV_REST_API_READ_ONLY_TOKEN=""
